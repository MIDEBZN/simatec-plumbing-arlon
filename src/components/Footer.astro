---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Company Overview -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-cyan-500/20">
            S
          </div>
          <span class="text-2xl font-extrabold text-white tracking-tight">SIMATEC</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed">
          Votre partenaire d'excellence pour tous vos travaux de plomberie, débouchage canalisation, chauffage et rénovation de salle de bain à Arlon et dans toute la province de Luxembourg.
        </p>
        <div class="pt-1 space-y-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Agréé Wallonie & Professionnel Certifié
          </span>
          <p class="text-xs text-slate-400 font-mono">
            TVA : BE 0821.663.145
          </p>
        </div>
      </div>

      <!-- Quick Services -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide uppercase text-xs text-cyan-400">Nos Prestations</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/services#depannage" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>›</span> Dépannage Urgent 24/7</a></li>
          <li><a href="/services#chauffage" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>›</span> Chauffage & Chaudières</a></li>
          <li><a href="/services#debouchage" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>›</span> Débouchage Haute Pression</a></li>
          <li><a href="/services#renovation" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>›</span> Rénovation Salle de Bain</a></li>
          <li><a href="/services#recherche-fuite" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>›</span> Recherche de Fuites Thermique</a></li>
          <li><a href="/services#adoucisseur" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>›</span> Adoucisseurs d'Eau</a></li>
        </ul>
      </div>

      <!-- Service Locations in Arlon region -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide uppercase text-xs text-cyan-400">Zones d'Intervention</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/locations#arlon" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>•</span> Arlon Centre (6700)</a></li>
          <li><a href="/locations#messancy" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>•</span> Messancy & Athus</a></li>
          <li><a href="/locations#aubange" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>•</span> Aubange & Halanzy</a></li>
          <li><a href="/locations#attert" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>•</span> Attert & Nobressart</a></li>
          <li><a href="/locations#etalle" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>•</span> Etalle & Habay</a></li>
          <li><a href="/locations#luxembourg" class="hover:text-cyan-400 transition-colors flex items-center gap-2"><span>•</span> Frontière Luxembourg (Steinfort)</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <h3 class="text-white font-bold text-base mb-4 tracking-wide uppercase text-xs text-cyan-400">Contact & Urgences</h3>
        <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-3 text-sm">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-cyan-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>Chem. de Weyler 48,<br/>6700 Arlon, Belgique</span>
          </div>

          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:0488588046" class="text-white font-bold hover:text-cyan-400 transition-colors">0488 58 80 46</a>
          </div>

          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href="mailto:contact@simatec.site" class="text-slate-300 hover:text-cyan-400 transition-colors">contact@simatec.site</a>
          </div>

          <div class="flex items-center gap-3 pt-1 border-t border-slate-800">
            <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-emerald-400 font-semibold text-xs">Service Dépannage 24h/24 & 7j/7</span>
          </div>
        </div>
      </div>

    </div>

    <div class="pt-8 border-t border-slate-900 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {currentYear} Simatec Plomberie Arlon. TVA : BE 0821.663.145. Tous droits réservés.</p>
      <div class="flex gap-6">
        <a href="/contact" class="hover:text-slate-400 transition-colors">Mentions Légales</a>
        <a href="/contact" class="hover:text-slate-400 transition-colors">Politique de Confidentialité</a>
        <a href="/sitemap-0.xml" class="hover:text-slate-400 transition-colors">Plan du Site</a>
      </div>
    </div>
  </div>
</footer>
