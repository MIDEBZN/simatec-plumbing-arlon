---
import Layout from '../layouts/Layout.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';

const locationZones = [
  {
    id: "arlon",
    city: "Arlon (6700)",
    status: "Zone Principale - Intervention Express",
    delay: "< 20 - 30 minutes",
    districts: ["Arlon Centre", "Stockem", "Weyler", "Waltzing", "Viville", "Autelbas", "Barnich", "Sterpenich", "Guirsch", "Udange"],
    description: "Siège social et équipe d'astreinte permanente situés à Arlon. Intervention prioritaire pour tout dépannage de plomberie ou de chauffage."
  },
  {
    id: "messancy",
    city: "Messancy & Environs (6780)",
    status: "Intervention Rapide",
    delay: "< 30 minutes",
    districts: ["Messancy Centre", "Hondelange", "Wolkrange", "Habergy", "Bébange", "Longeau"],
    description: "Déplacements quotidiens pour entretien de chaudière, débouchage urgent et installation sanitaire dans toute la commune de Messancy."
  },
  {
    id: "aubange",
    city: "Aubange & Athus (6790)",
    status: "Intervention Rapide",
    delay: "< 30 minutes",
    districts: ["Aubange", "Athus", "Halanzy", "Rachecourt"],
    description: "Service complet de plomberie et dépannage 24/7 pour les résidents d'Aubange, Athus et du pôle tri-frontalier."
  },
  {
    id: "attert",
    city: "Attert & Vallée de l'Attert (6717)",
    status: "Intervention Garantie",
    delay: "< 35 minutes",
    districts: ["Attert", "Nobressart", "Nothomb", "Thiaumont", "Tontelange", "Grendel"],
    description: "Prise en charge rapide de vos projets de chauffage et dépannage dans la vallée de l'Attert."
  },
  {
    id: "etalle",
    city: "Etalle, Habay & Tintigny (6740, 6720)",
    status: "Intervention Garantie",
    delay: "< 35 minutes",
    districts: ["Etalle", "Habay-la-Neuve", "Habay-la-Vieille", "Anlier", "Marbehan", "Rulles"],
    description: "Service de plomberie mobile pour tous vos besoins en installation sanitaire, adoucisseur et rénovation."
  },
  {
    id: "luxembourg",
    city: "Frontière Luxembourgeoise",
    status: "Zone Frontalière",
    delay: "< 35 - 45 minutes",
    districts: ["Steinfort", "Capellen", "Windhof", "Mamer", "Kleinbettingen", "Hagen"],
    description: "Assistance rapide pour les travailleurs frontaliers et résidents luxembourgeois proches du poste de Sterpenich."
  }
];
---

<Layout
  title="Zones d'Intervention Plomberie Arlon & Luxembourg | SIMATEC"
  description="Simatec intervient rapidement à Arlon (6700), Messancy, Aubange, Attert, Etalle et sur la frontière du Luxembourg pour tous vos dépannages de plomberie et chauffage."
>
  <!-- Header -->
  <section class="bg-slate-950 pt-16 pb-16 border-b border-slate-800 text-center relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 text-xs font-bold uppercase tracking-wider">
        Proximité & Réactivité
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Nos Zones d'Intervention en Plomberie
      </h1>
      <p class="text-slate-400 text-lg max-w-3xl mx-auto">
        Découvrez les communes couvertes par nos équipes d'astreinte 24h/24 & 7j/7 dans le Sud-Luxembourg belge et la région frontalière.
      </p>
    </div>
  </section>

  <!-- Location Search / Checker Interactive Box -->
  <section class="py-12 bg-slate-900 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-800/90 border border-slate-700 p-6 sm:p-8 rounded-2xl shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center md:text-left">
          <h3 class="text-xl font-bold text-white">Vérifiez si nous intervenons dans votre commune</h3>
          <p class="text-xs text-slate-400">Entrez votre code postal ou nom de localité (ex: 6700, Messancy, Athus...)</p>
        </div>

        <div class="w-full md:w-auto flex items-center gap-2">
          <input
            type="text"
            id="postal-input"
            placeholder="Ex: 6700 Arlon"
            class="bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500 w-full md:w-64"
          />
          <button
            id="postal-check-btn"
            type="button"
            class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-5 py-3 rounded-xl text-sm shrink-0 transition-colors"
          >
            Vérifier
          </button>
        </div>
      </div>
      <div id="postal-result" class="mt-4 hidden p-4 rounded-xl text-sm font-semibold text-center"></div>
    </div>
  </section>

  <!-- Location Cards Grid -->
  <section class="py-20 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {locationZones.map(zone => (
          <div id={zone.id} class="bg-slate-800/60 border border-slate-700/80 p-8 rounded-2xl hover:border-cyan-500/50 transition-all space-y-5 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  {zone.status}
                </span>
                <span class="text-xs text-cyan-400 font-semibold flex items-center gap-1">
                  ⏱️ {zone.delay}
                </span>
              </div>

              <h2 class="text-2xl font-bold text-white">
                {zone.city}
              </h2>

              <p class="text-slate-300 text-sm leading-relaxed">
                {zone.description}
              </p>

              <div>
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Localités incluses :</h3>
                <div class="flex flex-wrap gap-1.5">
                  {zone.districts.map(dist => (
                    <span class="text-[11px] bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-700/60">
                      {dist}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-700/60">
              <a
                href="tel:+3263998877"
                class="w-full bg-slate-900 hover:bg-cyan-500 hover:text-slate-950 text-cyan-400 border border-slate-700 font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 transition-colors"
              >
                Appeler pour {zone.city.split(' ')[0]}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Emergency Banner -->
  <EmergencyBanner />

  <script>
    const input = document.getElementById('postal-input') as HTMLInputElement;
    const btn = document.getElementById('postal-check-btn');
    const result = document.getElementById('postal-result');

    if (btn && input && result) {
      btn.addEventListener('click', () => {
        const val = input.value.trim().toLowerCase();
        if (!val) return;

        const covered = ['6700', 'arlon', 'messancy', '6780', 'aubange', 'athus', '6790', 'attert', '6717', 'etalle', '6740', 'habay', '6720', 'steinfort', 'luxembourg'];
        const isCovered = covered.some(c => val.includes(c));

        result.classList.remove('hidden', 'bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/30', 'bg-amber-500/10', 'text-amber-400', 'border-amber-500/30');

        if (isCovered) {
          result.classList.add('bg-emerald-500/10', 'text-emerald-400', 'border', 'border-emerald-500/30');
          result.innerHTML = `✅ <strong>Parfait !</strong> Nous intervenons en moins de 30 minutes sur la zone "${input.value}". Appelez le <a href="tel:+3263998877" class="underline font-bold">+32 63 99 88 77</a>.`;
        } else {
          result.classList.add('bg-amber-500/10', 'text-amber-400', 'border', 'border-amber-500/30');
          result.innerHTML = `ℹ️ Nous couvrons l'ensemble de la Province de Luxembourg. Contactez-nous au <a href="tel:+3263998877" class="underline font-bold">+32 63 99 88 77</a> pour confirmer le délai exact.`;
        }
      });
    }
  </script>
</Layout>
