---
import Layout from '../layouts/Layout.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
---

<Layout
  title="Contact & Devis Gratuit Plomberie Arlon | SIMATEC"
  description="Besoin d'un dépannage urgent ou d'un devis gratuit à Arlon ? Contactez Simatec au +32 63 99 88 77 ou via notre formulaire en ligne. Réponse rapide garantie."
>
  <!-- Header -->
  <section class="bg-slate-950 pt-16 pb-16 border-b border-slate-800 text-center relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 text-xs font-bold uppercase tracking-wider">
        Assistance & Devis Gratuit
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Contactez la société SIMATEC à Arlon
      </h1>
      <p class="text-slate-400 text-lg max-w-3xl mx-auto">
        Une question, une urgence ou un projet de rénovation ? Nos équipes sont à votre disposition 24/7.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Grid -->
  <section class="py-20 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Contact Information Cards -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-white">Nos Coordonnées à Arlon</h2>
            <p class="text-slate-300 text-sm leading-relaxed">
              Pour toute demande d'intervention urgente, privilégiez le contact téléphonique direct pour une réponse immédiate.
            </p>
          </div>

          <!-- Emergency Hotline Box -->
          <div class="bg-gradient-to-br from-red-950/80 to-slate-900 p-6 rounded-2xl border border-red-800/40 space-y-3">
            <div class="flex items-center gap-2 text-red-400 text-xs font-bold uppercase tracking-wider">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
              Ligne directe Urgences 24/7
            </div>
            <p class="text-2xl sm:text-3xl font-extrabold text-white">
              +32 63 99 88 77
            </p>
            <p class="text-slate-300 text-xs">
              Intervention en moins de 30 minutes sur Arlon, Messancy, Aubange et environs.
            </p>
            <a
              href="tel:+3263998877"
              class="inline-flex items-center justify-center gap-2 w-full bg-red-600 hover:bg-red-500 text-white font-bold py-3 rounded-xl text-sm transition-all shadow-lg shadow-red-600/30"
            >
              Appeler le 063 99 88 77
            </a>
          </div>

          <!-- Contact Details list -->
          <div class="bg-slate-800/60 p-6 rounded-2xl border border-slate-700/80 space-y-5 text-sm">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-cyan-400 flex items-center justify-center shrink-0 border border-slate-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <strong class="text-white block text-base">Adresse du Siège</strong>
                <p class="text-slate-300">Avenue de Longwy 142<br/>6700 Arlon, Belgique</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-cyan-400 flex items-center justify-center shrink-0 border border-slate-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <strong class="text-white block text-base">Email</strong>
                <a href="mailto:contact@simatec-plomberie.be" class="text-cyan-400 hover:underline">contact@simatec-plomberie.be</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-cyan-400 flex items-center justify-center shrink-0 border border-slate-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <strong class="text-white block text-base">Heures d'ouverture</strong>
                <p class="text-slate-300">Bureau : Lundi - Vendredi (8h00 - 18h00)</p>
                <p class="text-emerald-400 font-semibold mt-1">Dépannage d'urgence : 24h/24 & 7j/7</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Comprehensive Contact / Quote Form -->
        <div class="lg:col-span-7">
          <div class="bg-slate-800/80 border border-slate-700 p-8 rounded-3xl shadow-2xl space-y-6">
            <div>
              <h2 class="text-2xl font-bold text-white">Formulaire de Demande de Devis</h2>
              <p class="text-slate-400 text-xs mt-1">Remplissez ce formulaire pour recevoir un devis gratuit et personnalisé sous 1h.</p>
            </div>

            <form id="contact-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-name" class="block text-xs font-semibold text-slate-300 mb-1">Nom & Prénom *</label>
                  <input type="text" id="contact-name" required placeholder="Jean Dupont" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500" />
                </div>
                <div>
                  <label for="contact-phone" class="block text-xs font-semibold text-slate-300 mb-1">Téléphone *</label>
                  <input type="tel" id="contact-phone" required placeholder="0470 12 34 56" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-email" class="block text-xs font-semibold text-slate-300 mb-1">Email *</label>
                  <input type="email" id="contact-email" required placeholder="jean.dupont@example.be" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500" />
                </div>
                <div>
                  <label for="contact-city" class="block text-xs font-semibold text-slate-300 mb-1">Commune / Code Postal *</label>
                  <input type="text" id="contact-city" required placeholder="6700 Arlon" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-service" class="block text-xs font-semibold text-slate-300 mb-1">Service concerné</label>
                  <select id="contact-service" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500">
                    <option value="depannage">Dépannage d'Urgence</option>
                    <option value="chauffage">Chauffage & Chaudière</option>
                    <option value="debouchage">Débouchage Canalisation</option>
                    <option value="renovation">Rénovation Salle de Bain</option>
                    <option value="fuite">Recherche de Fuite</option>
                    <option value="adoucisseur">Adoucisseur d'Eau</option>
                  </select>
                </div>
                <div>
                  <label for="contact-urgency" class="block text-xs font-semibold text-slate-300 mb-1">Degré d'urgence</label>
                  <select id="contact-urgency" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500">
                    <option value="normal">Normal (Sous 24h - 48h)</option>
                    <option value="urgent">Urgent (&lt; 30 minutes)</option>
                    <option value="project">Projet à planifier</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-semibold text-slate-300 mb-1">Description de votre demande</label>
                <textarea id="contact-message" rows="4" placeholder="Précisez votre besoin (ex: fuite sous l'évier, bruit étrange dans la chaudière, devis rénovation...)" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500"></textarea>
              </div>

              <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold py-4 rounded-xl shadow-lg shadow-cyan-500/25 transition-all text-sm uppercase tracking-wider">
                Envoyer ma demande de devis
              </button>

              <div id="form-success" class="hidden p-4 bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 rounded-xl text-xs text-center font-semibold">
                ✓ Merci ! Votre message a bien été transmis à l'équipe Simatec. Nous vous recontacterons très rapidement.
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Emergency Banner -->
  <EmergencyBanner />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');

    if (form && successMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        successMsg.classList.remove('hidden');
        form.reset();
      });
    }
  </script>
</Layout>
